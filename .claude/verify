# TitleTrack verification for the user-level Stop gate (~/.claude/hooks/stop_gate.py).
# First non-comment line is the command; it runs from the repo root and a
# non-zero exit blocks stopping.
#
# shell: bash
# timeout: 300
#
# Deliberately the SAME runner CI uses, so the hook and CI can never disagree
# about what "verified" means. Three of the four agent baselines exit 1 by
# design, so verify.sh asserts expected exit codes rather than success.
sh scripts/verify.sh
